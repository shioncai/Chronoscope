{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chronoscope",
  "version": "../package.json",
  "identifier": "com.shionchoy.chronoscope",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "TAURI=1 vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Chronoscope",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
